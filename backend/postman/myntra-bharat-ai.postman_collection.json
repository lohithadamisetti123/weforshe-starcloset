{
  "info": {
    "name": "Myntra Bharat AI \u2014 Backend API",
    "description": "WeForShe HackerRamp 2026. Import this collection, set `baseUrl` (default http://localhost:8080/api/v1) and run 'Register' or rely on the auto-generated X-Session-Id guest flow \u2014 every authenticated request below sends both a bearer token (once you've logged in) and a guest session header, so the collection works whether or not you register.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": "postman-demo-session-001"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "recommendationId",
      "value": ""
    },
    {
      "key": "historyId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates an account and returns a token pair. The email includes a random suffix so this can be re-run.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Menon\",\n  \"email\": \"asha+{{$randomInt}}@example.com\",\n  \"password\": \"correct-horse-battery\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.data && data.data.tokens) {",
                  "    pm.collectionVariables.set('accessToken', data.data.tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', data.data.tokens.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (seeded demo user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Uses the demo account created by the seeder \u2014 see database/seed/seed.go.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"asha@myntra.dev\",\n  \"password\": \"bharat-ai-demo\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.data && data.data.tokens) {",
                  "    pm.collectionVariables.set('accessToken', data.data.tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', data.data.tokens.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.data && data.data.tokens) {",
                  "    pm.collectionVariables.set('accessToken', data.data.tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', data.data.tokens.refreshToken);",
                  "}"
                ]
