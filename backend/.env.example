# ---------------------------------------------------------------------------
# Myntra Bharat AI — Backend environment
# Copy to `.env` and adjust. Every var below is read through Viper.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=8080
ENV=development                 # development | production
LOG_LEVEL=debug                 # debug | info | warn | error
REQUEST_TIMEOUT_SECONDS=20

# --- Database ---
# Inside docker-compose the host is `postgres`; locally it is `localhost`.
DATABASE_URL=postgres://myntra:myntra@localhost:5432/myntra_bharat_ai?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_AUTO_MIGRATE=true            # run golang-migrate on boot
DB_AUTO_SEED=true               # seed the 52-product catalogue on boot (idempotent)

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_MINUTES=10

# --- Auth ---
JWT_SECRET=change-me-in-production-please-use-32-chars-min
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_HOURS=168

# --- Gemini ---
# Leave GEMINI_API_KEY empty to run fully offline: the assistant transparently
# falls back to the deterministic rule-based NLU extractor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=8
GEMINI_ENABLED=true

# --- CORS (frontend origins, comma separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173
CORS_ALLOW_CREDENTIALS=true

# --- Rate limiting ---
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
ASSISTANT_RATE_LIMIT_RPS=2
ASSISTANT_RATE_LIMIT_BURST=5

# --- Guest mode ---
# The shipped frontend has no auth UI. When true, unauthenticated calls to
# /assistant, /history and /favorites are bound to a per-browser guest identity
# derived from the X-Session-Id header instead of returning 401.
ALLOW_GUEST=true

# --- Recommendation engine weights (tunable without a rebuild) ---
REC_W_OCCASION=0.24
REC_W_STYLE=0.15
REC_W_GENDER=0.10
REC_W_CATEGORY=0.09
REC_W_BUDGET=0.18
REC_W_COLOR=0.05
REC_W_BRAND=0.04
REC_W_TEXT=0.09
REC_W_QUALITY=0.09
REC_W_VALUE=0.05
REC_DIVERSITY_LAMBDA=0.72
REC_TOP_N=6
REC_CANDIDATE_POOL=200
